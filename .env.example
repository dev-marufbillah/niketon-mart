# Copy this file to .env.local for local development.
# Never put real credentials in this file or commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The protected owner identity is fixed in server-side configuration.
SUPER_ADMIN_EMAIL=marufsalauddin76@gmail.com
# Required only when provisioning a new owner; use a unique 12-256 character secret.
SUPER_ADMIN_PASSWORD=

# Leave MONGODB_URI empty for local JSON development.
# Vercel production requires a dedicated, backed-up MongoDB database.
MONGODB_URI=
MONGODB_DB=niketon_mart

# Vercel image uploads require durable Blob storage.
BLOB_READ_WRITE_TOKEN=

# Optional real email delivery; configure a verified sender before using invitations or resets.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
CUSTOMER_EMAIL_FROM=

# Optional customer-only Google sign-in. Configure every value together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Use a unique random secret of at least 32 bytes.
GOOGLE_OAUTH_COOKIE_SECRET=

# Optional maintenance bearer token; leave unset unless explicitly required.
ADMIN_API_TOKEN=
